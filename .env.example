# Configuracion de Docker Compose. Copia este fichero a .env y rellenalo.
# .env NO se sube a git (esta en .gitignore).
#
# Los secretos se pueden generar con:  sh scripts/generar-secretos.sh >> .env
# (y despues borra de aqui abajo las lineas vacias que se repitan).

# --- Dominio -----------------------------------------------------------------
# Dominio donde vivira el hub. Tiene que apuntar a esta maquina.
# Para probar en local sin dominio: HUB_DOMAIN=hub.localhost y TLS_CERT_RESOLVER=
HUB_DOMAIN=hub.example.com
# "letsencrypt" = certificado real (puerto 80 accesible desde internet).
# Vacio = certificado autofirmado (el navegador avisara).
TLS_CERT_RESOLVER=letsencrypt
ACME_EMAIL=
HTTP_PORT=80
HTTPS_PORT=443
TZ=Europe/Madrid

# --- Imagenes ----------------------------------------------------------------
# Las que compila scripts/build-images.sh (por defecto compra-hub/<app>:latest).
REGISTRY=compra-hub
TAG=latest

# --- Secretos (generalos, no uses estos valores vacios) ------------------------
POSTGRES_PASSWORD=
LISTA_COMPRA_DB_PASSWORD=
CALENDARIO_DB_PASSWORD=
TODO_DB_PASSWORD=
GASTOS_DB_PASSWORD=
MENU_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=
# Contraseña del usuario "admin" de la consola de Keycloak (/auth/admin).
KEYCLOAK_ADMIN_PASSWORD=
# Secreto del cliente "compras" de Keycloak (se importa en el realm) y
# secreto de la cookie de sesion (32 bytes en base64).
OAUTH2_PROXY_CLIENT_SECRET=
OAUTH2_PROXY_COOKIE_SECRET=

# --- Avisos push (opcional) ----------------------------------------------------
# Sin estas claves el hub funciona igual, pero sin notificaciones push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@email.com

# --- Asistente y comparador de precios (opcional) ------------------------------
# Ollama con un modelo que sepa usar herramientas. Sin Ollama, el asistente
# aparece como «no disponible» y el comparador elige el producto con una
# regla sencilla.
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=gemma4:e4b
# "true" publica el servidor MCP en https://<HUB_DOMAIN>/mcp para clientes
# MCP externos (Open WebUI...). Ver README, «Asistente y MCP».
HUB_MCP_PUBLIC=false
# Almacen de Mercadona cuyos precios se consultan (depende de tu zona).
MERCADONA_WAREHOUSE=4045

# --- Google Calendar (opcional) ------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
