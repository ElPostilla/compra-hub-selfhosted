# Configuracion del hub en Kubernetes (ConfigMap hub-config). Edita al menos
# HUB_DOMAIN y las dos URLs de Keycloak.
HUB_DOMAIN=hub.example.com
# Issuer publico del realm (lo que va en el "iss" de los tokens). Con el
# Keycloak incluido (k8s/keycloak.yaml) es https://<HUB_DOMAIN>/auth/realms/compras.
OIDC_ISSUER=https://hub.example.com/auth/realms/compras
# Claves publicas del realm por la red interna del cluster (sin salir a
# internet). Si usas un Keycloak que ya tenias, pon aqui su URL interna o
# borra la linea para usar <OIDC_ISSUER>/protocol/openid-connect/certs.
OIDC_JWKS_URI=http://keycloak:8080/auth/realms/compras/protocol/openid-connect/certs
TZ=Europe/Madrid
# Asistente y comparador de precios (opcional): URL de tu Ollama.
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=gemma4:e4b
MERCADONA_WAREHOUSE=4045
VAPID_SUBJECT=mailto:admin@example.com
